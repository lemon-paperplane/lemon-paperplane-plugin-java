{
  "id": "java",
  "name": "%plugin.name%",
  "version": "0.1.0",
  "vendor": "Lemon Paperplane",
  "description": "%plugin.description%",
  "icon": "icons/java.svg",
  "category": "language",
  "engines": {
    "paperplane": ">=0.1.0 <0.2.0"
  },
  "protocol": 1,
  "executable": "bin/paperplane-plugin-java",
  "activation": {
    "files": [
      "*.java",
      "pom.xml",
      "build.gradle",
      "build.gradle.kts",
      "settings.gradle",
      "settings.gradle.kts",
      "src/"
    ],
    "facets": [
      "gradle",
      "maven",
      "kotlin"
    ]
  },
  "contributes": {
    "languages": [
      {"id": "java", "name": "Java", "extensions": [".java", ".jav"], "module": "editor/lang-java.js", "lineComment": "//", "blockComment": ["/*", "*/"]}
    ],
    "facets": [
      {
        "id": "java",
        "name": "Java",
        "icon": "icons/java.svg",
        "category": "language",
        "priority": 50
      }
    ],
    "toolchains": [
      {
        "kind": "jdk",
        "name": "JDK",
        "icon": "icons/java.svg",
        "installable": true
      }
    ],
    "runConfigurationTypes": [
      {
        "id": "java-application",
        "name": "%runType.application%",
        "icon": "icons/java.svg",
        "facets": [
          "java"
        ],
        "options": [
          {
            "key": "mainClass",
            "title": "%opt.mainClass%",
            "type": "string",
            "required": true,
            "placeholder": "com.example.Main"
          },
          {
            "key": "module",
            "title": "%opt.module%",
            "type": "select",
            "optionsFrom": "jvm.modules",
            "info": "%opt.module.info%"
          },
          {
            "key": "vmOptions",
            "title": "%opt.vmOptions%",
            "type": "string",
            "placeholder": "-Xmx1g"
          },
          {
            "key": "programArgs",
            "title": "%opt.programArgs%",
            "type": "string"
          },
          {
            "key": "workingDir",
            "title": "%opt.workingDir%",
            "type": "path",
            "info": "%opt.workingDir.info%",
            "advanced": true
          }
        ]
      }
    ],
    "services": [
      "buildCommand"
    ],
    "ideRunConfigTypes": [
      "Application"
    ],
    "diagnostics": [
      {
        "id": "java.class-version-52",
